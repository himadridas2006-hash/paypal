# ========================================================
# MANDATE SPEND GUARDRAILS & FIDUCIARY ESCROW (.env.example)
# ========================================================

# PayPal Sandbox Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Base App URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Gemini (Unified LLM Provider for all AI Features)
# Leave empty to run in deterministic offline fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Approvals Bot (Optional - Long-polling, no public URL needed)
# Leave empty if Telegram bot is not configured
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MCP Server Config
PORT=3000
